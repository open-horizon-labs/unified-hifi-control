#!/bin/sh
# Post-upgrade script
# Runs after upgrade completes

PACKAGE_NAME="unified-hifi-control"
PACKAGE_DIR="/var/packages/${PACKAGE_NAME}"
TARGET_DIR="${SYNOPKG_PKGDEST:-${PACKAGE_DIR}/target}"

# Make binary executable
chmod +x "${TARGET_DIR}/unified-hifi-control"

echo "Unified Hi-Fi Control by Open Horizon Labs upgraded successfully"

exit 0
