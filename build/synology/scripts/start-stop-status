#!/bin/sh

PACKAGE_NAME="unified-hifi-control"
PACKAGE_DIR="/var/packages/${PACKAGE_NAME}"
TARGET_DIR="${SYNOPKG_PKGDEST:-${PACKAGE_DIR}/target}"
VAR_DIR="${PACKAGE_DIR}/var"
HOME_DIR="${PACKAGE_DIR}/home"
BINARY="${TARGET_DIR}/unified-hifi-control"
PID_FILE="${VAR_DIR}/${PACKAGE_NAME}.pid"
LOG_FILE="${VAR_DIR}/${PACKAGE_NAME}.log"

read_pid() {
    cat "$PID_FILE" 2>/dev/null || true
}

pid_is_running() {
    PID=$1

    [ -n "$PID" ] || return 1
    kill -0 "$PID" 2>/dev/null || return 1

    # Avoid signaling an unrelated process if DSM has reused a stale PID.
    if [ -r "/proc/${PID}/cmdline" ]; then
        tr '\000' '\n' < "/proc/${PID}/cmdline" | grep -Fqx "$BINARY" || return 1
    fi

    return 0
}

start_daemon() {
    if [ -f "$PID_FILE" ]; then
        PID=$(read_pid)
        if pid_is_running "$PID"; then
            echo "${PACKAGE_NAME} is already running"
            return 0
        fi
        # Stale PID file
        rm -f "$PID_FILE"
    fi

    echo "Starting ${PACKAGE_NAME}..."

    mkdir -p "$VAR_DIR"

    if ! cd "$TARGET_DIR"; then
        echo "Failed to change to ${TARGET_DIR}"
        return 1
    fi

    export HOME="$HOME_DIR"
    export UHC_CONFIG_DIR="$VAR_DIR"
    export UHC_DATA_DIR="$VAR_DIR"
    export RUST_LOG="${RUST_LOG:-info}"

    nohup "$BINARY" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # Wait for process to start (configurable via STARTUP_WAIT)
    sleep "${STARTUP_WAIT:-2}"

    PID=$(read_pid)
    if pid_is_running "$PID"; then
        echo "${PACKAGE_NAME} started successfully"
        return 0
    else
        echo "Failed to start ${PACKAGE_NAME}"
        rm -f "$PID_FILE"
        return 1
    fi
}

stop_daemon() {
    if [ ! -f "$PID_FILE" ]; then
        echo "${PACKAGE_NAME} is not running"
        return 0
    fi

    echo "Stopping ${PACKAGE_NAME}..."

    PID=$(read_pid)
    if pid_is_running "$PID"; then
        kill "$PID"

        WAITED=0
        while pid_is_running "$PID" && [ "$WAITED" -lt "${SHUTDOWN_TIMEOUT:-10}" ]; do
            sleep 1
            WAITED=$((WAITED + 1))
        done

        if pid_is_running "$PID"; then
            echo "${PACKAGE_NAME} did not stop gracefully; sending SIGKILL"
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE"
    echo "${PACKAGE_NAME} stopped"
    return 0
}

daemon_status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(read_pid)
        if pid_is_running "$PID"; then
            return 0  # Running
        fi
        return 1  # Process is dead but PID file exists
    fi
    return 3  # Normally stopped
}

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        stop_daemon
        sleep 1
        start_daemon
        ;;
    status)
        if daemon_status; then
            echo "${PACKAGE_NAME} is running"
            exit 0
        else
            STATUS=$?
            echo "${PACKAGE_NAME} is not running"
            exit "$STATUS"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
