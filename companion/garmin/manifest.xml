<?xml version="1.0"?>
<!--
  Unified Hi-Fi Control — Garmin Connect IQ remote.

  A watch-app (not a widget) because the interaction is deliberate: the user
  opens it to drive a zone, then leaves. Widgets and glances are for passive
  glanceable state, which this is not — see README.md.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a1b2c3d4e5f6470891234567890abcde"
        type="watch-app"
        name="@Strings.AppName"
        entry="UhcApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <!--
          Every device that actually builds, verified one at a time rather
          than listed hopefully.

          The excluded models (fenix 3/5, vivoactive 1-4, chronos) fail on
          one thing: they predate the personality library, so Garmin's
          button-hint assets do not exist for them. That is a useful signal
          rather than an obstacle to route around. Those watches are
          touch-first with different button counts, so the button-driven
          design here would not suit them without its own layout pass.
        -->
        <iq:products>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7pronowifi"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7xpronowifi"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="fenix943mm"/>
            <iq:product id="fenix947mm"/>
            <iq:product id="fenix9pro43mm"/>
            <iq:product id="fenix9pro47mm"/>
            <iq:product id="fenix9pro51mm"/>
            <iq:product id="fenix9prosolar47mm"/>
            <iq:product id="fenix9prosolar51mm"/>
            <iq:product id="fenixe"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="vivoactive6"/>
        </iq:products>

        <iq:permissions>
            <!-- Talking to the UHC server. Nothing else is required: no
                 position, no sensors, no background. -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
